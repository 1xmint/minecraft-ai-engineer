    {
      "id": "observer-pulse",
      "name": "Observer edge detector",
      "explanation": "An observer watches a lever and emits a short pulse on both on and off edges. A settled off lamp does not prove that either pulse occurred. Testing must sample the detector, receiver and lamp on every game tick.",
      "maxDelay": 1,
      "settleTicks": 16,
      "stages": [
        {
          "id": "foundation",
          "title": "Support the pulse detector",
          "explanation": "Place three stone supports in a row.",
          "prerequisites": []
        },
        {
          "id": "input",
          "title": "Add the observed input",
          "explanation": "Place an off floor lever above the first support.",
          "prerequisites": ["foundation"]
        },
        {
          "id": "output",
          "title": "Face the observer toward the lever",
          "explanation": "Place the observer watching the lever (facing=west), with its red output facing the lamp. Every lever edge should produce a two-game-tick pulse after two game ticks; the lamp stays lit four ticks longer.",
          "prerequisites": ["foundation", "input"]
        }
