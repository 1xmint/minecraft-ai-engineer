{
  "name": "One-bit toggle memory",
  "explanation": "Each rising lever edge toggles a stored copper-bulb bit. Held high and falling inputs retain it. The same low input can therefore have either output, depending on earlier pulses. This is toggle memory, not a data-and-clock register.",
  "stages": [
    {
      "id": "foundation",
      "title": "Support the memory",
      "explanation": "Place four stone supports.",
      "prerequisites": []
    },
    {
      "id": "storage",
      "title": "Add the stored bit",
      "explanation": "A waxed copper bulb retains its lit bit after power is removed.",
      "prerequisites": ["foundation"]
    },
    {
      "id": "controls",
      "title": "Add the toggle control",
      "explanation": "Place an unpowered lever. Each rising edge toggles the stored bit once.",
      "prerequisites": ["foundation", "storage"]
    },
    {
      "id": "readout",
      "title": "Read the stored bit",
      "explanation": "The comparator reads the bulb and emits zero or fifteen into the output wire.",
      "prerequisites": ["foundation", "storage", "controls"]
    }
  ],
