   "id": "data-latch",
   "name": "Data latch",
   "model": "table",
   "summary": "Stores one bit. While Enable is on, the lamp follows Data. While Enable is off, the lamp holds its value.",
   "lesson": [
    "The Data lever feeds a repeater that drives the lamp.",
    "A second repeater presses on that repeater's side. A side-powered repeater is locked and keeps its output.",
    "Enable turns the torch off, which removes the lock, so Data passes through.",
    "With Enable off the torch relights and the lock returns, so changing Data has no effect."
   ],
   "controls": {
    "data": [
     0,
     0,
     0
    ],
    "enable": [
     1,
     0,
     4
    ]
   },
